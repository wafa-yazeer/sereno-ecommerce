            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sereno Tourbillon Perpetual\",\n  \"sku\": \"SER-TRB-99\",\n  \"categoryId\": \"cat-automatic\",\n  \"price\": 580.00,\n  \"originalPrice\": 690.00,\n  \"stock\": 5,\n  \"description\": \"Masterpiece complication with titanium flying tourbillon carriage and 72-hour power reserve.\",\n  \"dialColor\": \"Midnight Blue Enamel\",\n  \"caseSize\": \"41 MM\",\n  \"movement\": \"Calibre S-99 In-House Hand-Wound\",\n  \"glass\": \"Domed Sapphire Crystal with AR Coating\",\n  \"waterResistance\": \"10 ATM (100m)\",\n  \"strap\": \"Alligator Grain Hand-Stitched Leather\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1524592094714-0f0654e20314?w=800\",\n  \"badge\": \"Grand Complication\",\n  \"featured\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
