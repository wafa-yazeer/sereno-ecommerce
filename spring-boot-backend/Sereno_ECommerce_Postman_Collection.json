{
  "info": {
    "name": "SERENO Luxury E-Commerce - Java Spring Boot REST API Collection",
    "description": "Complete Postman collection for testing all CRUD endpoints across Products, Categories, Orders, and Reviews resources for SERENO Genève Spring Boot backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Products Resource (CRUD)",
      "item": [
        {
          "name": "GET All Products (with filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?category=all&sort=newest",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "category", "value": "all" },
                { "key": "sort", "value": "newest" }
              ]
            }
          }
        },
        {
          "name": "GET Product By ID",
          "request": {
            "method": "GET",
            "header": [],
